<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Beranda.BerandaFragment">

    <!-- APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Light"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FBF8FF"
            app:layout_scrollFlags="scroll|enterAlways"
            app:subtitleTextColor="#8A4B5E"
            app:titleTextColor="#1B1B21" />

    </com.google.android.material.appbar.AppBarLayout>


    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. BANNER SAPAAN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Haloo, Ibu Peri"
                        android:textColor="#1B1B21"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/imageView3" />

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Semoga Ibu dan buah hati sehat, riang dan senantiasa terawat"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        app:layout_constraintTop_toBottomOf="@id/textView10"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/imageView3" />

                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:srcCompat="@drawable/logo_ibu_hamil"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- 2. CARD JANJI MENDATANG -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardJanjiMendatang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#FFF5F0"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2C8B9"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- ICON HEADER -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHeaderIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="#EFE1D8"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivHeaderIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="10dp"
                            app:srcCompat="@drawable/ic_calender"
                            app:tint="#5D3A29" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- SUBTITLE -->
                    <TextView
                        android:id="@+id/tvSubtitleJanji"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:letterSpacing="0.05"
                        android:text="JANJI MENDATANG"
                        android:textColor="#7A5643"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toEndOf="@id/cardHeaderIcon"
                        app:layout_constraintEnd_toStartOf="@id/cardBadgeCountdown"
                        app:layout_constraintTop_toTopOf="@id/cardHeaderIcon" />

                    <!-- TITLE -->
                    <TextView
                        android:id="@+id/tvTitleJanji"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp"
                        android:text="Pemeriksaan Kehamilan\nTrimester 2"
                        android:textColor="#1B1B21"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="2dp"
                        app:layout_constraintStart_toEndOf="@id/cardHeaderIcon"
                        app:layout_constraintEnd_toStartOf="@id/cardBadgeCountdown"
                        app:layout_constraintTop_toBottomOf="@id/tvSubtitleJanji" />

                    <!-- BADGE COUNTDOWN -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBadgeCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#6D4330"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvBadgeCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="H-4 Hari"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- INNER DETAIL CARD -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/innerCardDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp"
                        app:layout_constraintTop_toBottomOf="@id/tvTitleJanji">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <!-- TANGGAL -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    app:cardBackgroundColor="#F4EFEF"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="6dp"
                                        app:srcCompat="@drawable/ic_calender"
                                        app:tint="#6D4330" />

                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:text="12 Oktober 2026 • 09.00 WIB"
                                    android:textColor="#1B1B21"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- LOKASI -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    app:cardBackgroundColor="#F4EFEF"
                                    app:cardCornerRadius="8dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:padding="6dp"
                                        app:srcCompat="@drawable/ic_apps"
                                        app:tint="#6D4330" />

                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:text="Puskesmas Melati / dr. Sarah, Sp.OG"
                                    android:textColor="#666666"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- 3. JUDUL MENU FITUR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    app:srcCompat="@drawable/ic_apps"
                    app:tint="#8A4B5E" />

                <TextView
                    android:id="@+id/textFitur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu Fitur Utama"
                    android:textColor="#1B1B21"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- 4. CARD KESEHATAN IBU -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="20dp"
                app:strokeColor="#8A4B5E"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imageView5"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="8dp"
                        app:srcCompat="@drawable/logo_ibu_hamil" />

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kesehatan Ibu"
                        android:textColor="#1B1B21"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Pantau tensi darah, pertambahan BB dan perkembangan janin mingguan"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnKesehatanIbu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#8A4B5E"
                        android:text="Lihat Kesehatan Ibu"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- 5. CARD JADWAL DAN PENGINGAT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="20dp"
                app:strokeColor="#D4D2E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imageView6"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="8dp"
                        app:srcCompat="@drawable/ic_kalender" />

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jadwal &amp; Pengingat"
                        android:textColor="#1B1B21"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Agenda kontrol kehamilan, jadwal Posyandu melati, dan sesi konsultasi bidan."
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnKalender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#303037"
                        android:text="Buka Kalender"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- 6. CARD ARTIKEL KESEHATAN -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardArtikelKesehatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/white"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#E8C6D5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ICON ARTIKEL -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_apps"
                        app:tint="#8A4B5E" />

                    <!-- JUDUL -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Artikel Kesehatan"
                        android:textColor="#1B1B21"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- DESKRIPSI -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Temukan berbagai informasi dan tips kesehatan ibu hamil, bayi, serta anak dari sumber terpercaya."
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <!-- TOMBOL ARTIKEL -->
                    <Button
                        android:id="@+id/btnArtikelKesehatan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#8A4B5E"
                        android:text="Baca Artikel Kesehatan"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:clickable="false"
                        android:focusable="false"
                        app:cornerRadius="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
